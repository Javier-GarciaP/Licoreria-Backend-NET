# =========================================================
# Plantilla de variables de entorno para desarrollo local.
# Copiar a .env y ajustar los valores. Nunca versionar .env
# =========================================================

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=licoreria
POSTGRES_USER=licoreria
POSTGRES_PASSWORD=licoreria
POSTGRES_PORT=5432

# --- API ---
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Production
JWT_KEY=licoreria-dev-secret-key-change-in-production-0123456789
JWT_ISSUER=LicoreriaAPI
JWT_AUDIENCE=LicoreriaClientes

# --- Reglas de negocio ---
# Puntos de fidelidad por USD pagado sin crédito (0 desactiva la acumulación automática)
FIDELIDAD_PUNTOS_POR_USD=1
# Días de plazo por defecto de una venta a crédito (fiado)
CREDITO_DIAS_VENCIMIENTO=30

# --- Frontend (contenedores) ---
ADMIN_PORT=4173
SPA_PORT=8080
PUBLIC_PORT=4174
SERVICIO_PORT=4175
EDGE_PORT=8090

# --- pgAdmin (opcional; perfil "tools") ---
PGADMIN_EMAIL=admin@licoreria.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
