# =========================================================
# Plantilla de variables de entorno para desarrollo local.
# Copiar a .env y ajustar los valores. Nunca versionar .env
# =========================================================

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=licoreria
POSTGRES_USER=licoreria
POSTGRES_PASSWORD=licoreria
POSTGRES_PORT=5432

# --- API ---
API_PORT=5190
ASPNETCORE_ENVIRONMENT=Production
JWT_KEY=licoreria-dev-secret-key-change-in-production-0123456789
JWT_ISSUER=LicoreriaAPI
JWT_AUDIENCE=LicoreriaClientes

# --- Frontend (contenedores) ---
ADMIN_PORT=4173
PUBLIC_PORT=4174
EDGE_PORT=8090

# --- pgAdmin (opcional; perfil "tools") ---
PGADMIN_EMAIL=admin@licoreria.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
